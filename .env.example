# ==========================================
# Voice Multi-Agent Worker — Environment Config
# ==========================================
# Copy this file to `.env` and fill in real values.
# The `.env` file is gitignored — never commit real keys.

# ---------- Groq Cloud (free LLM inference) ----------
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# ---------- Retell AI (voice agents) ----------
# Get yours at: https://www.retellai.com (Settings → API Keys)
RETELL_API_KEY=key_your_key_here

# ---------- GitHub (repo creation) ----------
# Create a Personal Access Token with `repo` scope:
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# ---------- Netlify (site deployment) ----------
# Get yours at: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=your_netlify_token_here

# ---------- Optional: Task customization ----------
# These control what the worker creates on each run.
# Change them to avoid "name already exists" errors.
RETELL_AGENT_NAME=Multiagent Voice Demo
GITHUB_REPO_NAME=voice-multiagent-app
NETLIFY_SITE_NAME=voice-multiagent-demo